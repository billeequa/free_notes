<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="web-sync.db" />
        <exclude domain="database" path="web-sync.db-journal" />
        <exclude domain="database" path="web-sync.db-wal" />
        <exclude domain="database" path="web-sync.db-shm" />
        <exclude domain="sharedpref" path="web-sync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="web-sync.db" />
        <exclude domain="database" path="web-sync.db-journal" />
        <exclude domain="database" path="web-sync.db-wal" />
        <exclude domain="database" path="web-sync.db-shm" />
        <exclude domain="sharedpref" path="web-sync.xml" />
    </device-transfer>
</data-extraction-rules>
